# Google Apps Script web app (google-apps-script/master) — see google-apps-script/SETUP.md
LEADS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
LEADS_WEBHOOK_SECRET=paste-the-secret-from-Inloop-CRM-menu

# Inloop CRM (inloop-crm) — POST /api/leads on the CRM. Same secret as CRM_INTAKE_SECRET there.
CRM_INTAKE_URL=https://your-crm-domain/api/leads
CRM_INTAKE_SECRET=paste-the-same-secret-as-the-crm
